# R15K Arcade – editor defaults: UTF-8, LF, 2 spaces, final newline, no trailing whitespace (Markdown
# keeps it for hard line breaks); Rust and Kotlin use 4 spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{rs,kt,kts}]
indent_size = 4
