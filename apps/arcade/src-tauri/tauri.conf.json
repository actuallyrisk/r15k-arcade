{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "R15K Arcade",
  "mainBinaryName": "r15k-arcade",
  "version": "0.1.0",
  "identifier": "dev.r15k.arcade",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm --dir ../.. dev",
    "beforeBuildCommand": "pnpm --dir ../.. build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "R15K Arcade",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "useHttpsScheme": true,
        "backgroundColor": "#ffffff",
        "zoomHotkeysEnabled": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "media-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "media-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:5173",
        "object-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "ArcadeGame",
    "publisher": "R15K",
    "copyright": "© 2026 R15K",
    "homepage": "https://r15k.dev",
    "license": "MIT",
    "shortDescription": "Small pixel games by R15K.",
    "longDescription": "R15K Arcade is a collection of small pixel games in the design of r15k.dev. Offline, free, no ads, no tracking.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "android": {
      "minSdkVersion": 28
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
