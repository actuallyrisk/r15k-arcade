{
  "name": "r15k-arcade",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "R15K Arcade – small pixel games in the design of r15k.dev",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm assets && pnpm --filter @r15k/arcade dev",
    "build": "pnpm assets && pnpm --filter @r15k/arcade build",
    "build:e2e": "pnpm assets && pnpm --filter @r15k/arcade build:e2e",
    "preview": "pnpm --filter @r15k/arcade preview",
    "verify": "node tools/src/verify/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build:e2e && pnpm --filter @r15k/arcade test:e2e",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --aggregate-output typecheck",
    "format": "node tools/src/format/main.ts --write",
    "format:check": "node tools/src/format/main.ts --check",
    "todo-check": "node tools/src/todo-check/main.ts",
    "snapshots:update": "node tools/src/snapshots/update.ts",
    "replays:update": "node tools/src/replays/update.ts",
    "native:prepare": "node tools/src/platform-patch/prepare.ts",
    "assets": "node tools/src/song-render/main.ts",
    "icons": "node tools/src/icons/main.ts",
    "sprite-check": "node tools/src/sprite-check/main.ts",
    "i18n-check": "node tools/src/i18n-check/main.ts",
    "licences": "node tools/src/licences/main.ts",
    "size-budget": "node tools/src/size-budget/main.ts",
    "tauri": "pnpm --filter @r15k/arcade tauri"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "globals": "catalog:",
    "happy-dom": "catalog:",
    "prettier": "catalog:",
    "release-please": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
