  },
  "devDependencies": {
    "@r15k/arcade": "workspace:*",
    "@r15k/bug-hunt": "workspace:*",
    "@r15k/engine": "workspace:*",
    "@r15k/ui": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wasm-media-encoders": "catalog:"
  }
}
