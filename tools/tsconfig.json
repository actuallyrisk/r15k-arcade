// R15K Arcade – development tools and their tests (run by Node 24 directly). DOM types because the tools
// import the workspace barrels, whose sources use DOM types.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
